; DATura game-screen presentation settings.
; This file controls DATura's title, nation-select, and player nameplate rendering.
; It intentionally does not style the Windows menu bar, settings dialogs,
; file dialogs, resource windows, or other operating-system controls.
;
; Ratios are relative to the game UI render width or height as indicated by the key.
; The renderer maps this coordinate space to the window so D3D textures, text,
; and mouse hitboxes remain aligned across fullscreen resolutions and DPI scales.
; RGB colors use R,G,B. ARGB colors use 0xAARRGGBB.

[ChatLog]
; Seconds after the latest dialogue before the log closes (1-300).
TimeoutSeconds=15
WidthPercent=50
HeightPercent=25

[Player.Nameplate]
Enabled=1
; Empty Name follows the character-creation name (Adventurer by default).
Name=
; One icon: none, linkshell, mentor, gm, away, seeking-party, disconnecting,
; auto-party, new-adventurer, bazaar, level-sync, trial, ballista-sandoria,
; ballista-bastok, ballista-windurst, ballista-griffon, ballista-wyvern,
; ballista-red, ballista-blue, sgm, lgm, developer, official-staff, tribune,
; campaign, campaign-seeking, campaign-auto-party, gladiator, gladiator-cg,
; gladiator-hcg, monipulator, monipulator-nm, monipulator-hnm,
; mentor-bronze, mentor-silver, mentor-gold (Assist chat badge previews).
; Change live through Config > Appearance > Player icon.
Icon=none
; Separate decoration above the name; can accompany any icon.
JobMaster=0
; Subtitle modes: none, linkshell, jobs. Edit live in Config > Appearance.
Subtitle=linkshell
LinkshellName=
; Temporary player presentation data until gameplay profiles are connected.
MainJob=WAR
MainLevel=1
SubJob=None
SubLevel=1
; Applied only to the Linkshell icon. R,G,B values from 0 through 255.
LinkshellColor=160,128,224

[Title.Assets]
LogoDat=ROM6/0/96.DAT
AtlasDat=ROM/119/50.DAT
UiDat=ROM/119/51.DAT
LogoTexture=ffxi
AtlasTexture=titlwin

